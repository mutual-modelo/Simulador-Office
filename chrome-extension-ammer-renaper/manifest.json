{
  "manifest_version": 3,
  "name": "AMMER - Pestaña Dividida y Asistente",
  "version": "1.0.2",
  "description": "Abre consultas y sitios externos (RENAPER, CajaJPER, Boletín Oficial, Drive, etc.) en pestaña dividida de Chrome a la derecha desde Simulador-Office, con asistente y cierre en un clic.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "AMMER - Pestaña Dividida y Asistente"
  },
  "permissions": [
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "https://tramites.renaper.gob.ar/*",
    "https://mutual-modelo.github.io/*",
    "http://localhost:*/*",
    "http://127.0.0.1:*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mutual-modelo.github.io/Simulador-Office/*",
        "http://localhost:*/*",
        "http://127.0.0.1:*/*"
      ],
      "js": [
        "bridge_simulador.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://tramites.renaper.gob.ar/*"
      ],
      "js": [
        "renaper_helper.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
