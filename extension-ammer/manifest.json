{
  "manifest_version": 3,
  "name": "Asistente AMMER — Gestor Documental",
  "version": "2.1.0",
  "description": "Centro de respaldo y sincronización documental local para Simulador-Office y Mutual Pay.",
  "permissions": [
    "downloads",
    "storage",
    "notifications",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "https://mutual-modelo.github.io/*",
    "https://*.onrender.com/*",
    "https://*.supabase.co/*",
    "https://drive.google.com/*",
    "http://localhost:*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "AMMER — Gestor Documental"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mutual-modelo.github.io/*",
        "https://*.onrender.com/*",
        "http://localhost:*/*",
        "http://127.0.0.1:*/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
