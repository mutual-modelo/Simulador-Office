{
  "manifest_version": 3,
  "name": "Asistente AMMER — Split View, Gestor Documental y Macros",
  "version": "2.5.2",
  "description": "Extensión unificada AMMER: RENAPER, Datuar & Drive Split View, respaldo documental local configurable y automatización con macros.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "tabs",
    "downloads",
    "storage",
    "notifications",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "https://tramites.renaper.gob.ar/*",
    "https://datuar.com/*",
    "https://*.datuar.com/*",
    "https://mutual-modelo.github.io/*",
    "https://*.onrender.com/*",
    "https://*.supabase.co/*",
    "https://drive.google.com/*",
    "http://localhost:*/*",
    "http://127.0.0.1:*/*"
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_popup": "popup.html",
    "default_title": "Asistente AMMER"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mutual-modelo.github.io/Simulador-Office/*",
        "http://localhost:*/*",
        "http://127.0.0.1:*/*"
      ],
      "js": ["bridge_simulador.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://tramites.renaper.gob.ar/*",
        "https://drive.google.com/*",
        "https://datuar.com/*",
        "https://*.datuar.com/*"
      ],
      "js": ["renaper_helper.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://mutual-modelo.github.io/*",
        "https://*.onrender.com/*",
        "http://localhost:*/*",
        "http://127.0.0.1:*/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
